{
  "schemaVersion": 1,
  "id": "omamobile.launcher",
  "name": "Mobile launcher",
  "version": "0.2.0",
  "author": "Omamobile",
  "license": "MIT",
  "description": "The phone's home bar and app drawer: one input at the bottom of the screen that searches apps, contacts and settings, does sums, opens the app grid (A-Z, with an app menu on a long press) and sends a prompt to your coding agent.",
  "kinds": [
    "panel"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "panel": "Launcher.qml"
  },
  "settings": {
    "defaults": {
      "columns": 4,
      "sentenceWords": 3,
      "sectionHeaders": false,
      "alphabetRail": true
    },
    "schema": [
      {
        "key": "columns",
        "type": "integer",
        "label": "Grid columns",
        "min": 3,
        "max": 6
      },
      {
        "key": "sentenceWords",
        "type": "integer",
        "label": "Words that make a prompt",
        "min": 2,
        "max": 8
      },
      {
        "key": "sectionHeaders",
        "type": "boolean",
        "label": "Letter headers in the app grid"
      },
      {
        "key": "alphabetRail",
        "type": "boolean",
        "label": "A-Z rail along the app grid"
      }
    ]
  }
}
