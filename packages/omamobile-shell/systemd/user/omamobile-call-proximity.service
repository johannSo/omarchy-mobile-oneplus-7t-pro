# SPDX-License-Identifier: MIT
# The screen off at the ear in calls (bin/omamobile-call-proximity), for
# every user's graphical session. Idle outside calls.
[Unit]
Description=Omarchy Mobile screen off at the ear in calls
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/omamobile-call-proximity
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
