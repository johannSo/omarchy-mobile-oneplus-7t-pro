# SPDX-License-Identifier: MIT
# hotdog camera bring-up options (CAMERA-PLAN.md section 5), on top of
# kernel.config, for the omamobile-hotdog-camera branch only:
#   scripts/kconfig/merge_config.sh -m -O $KERNEL_OUT $KERNEL_OUT/.config \
#     device/hotdog/kernel-camera.config
# Nothing here binds before the plan's overlays enable the nodes, except the
# camera clock controller, which only registers clocks and the TITAN_TOP GDSC.
CONFIG_SM_CAMCC_8150=m
CONFIG_I2C_QCOM_CCI=m
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_VIDEO_IMX471=m
CONFIG_VIDEO_S5K3M5=m
CONFIG_VIDEO_SONY_FWTABLE=m
CONFIG_V4L2_FLASH_LED_CLASS=m
