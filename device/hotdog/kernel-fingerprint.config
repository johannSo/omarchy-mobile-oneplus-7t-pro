# SPDX-License-Identifier: MIT
# hotdog fingerprint bring-up options (FINGERPRINT-PLAN.md section 5), on
# top of kernel.config, for the omamobile-hotdog-fingerprint branch only:
#   scripts/kconfig/merge_config.sh -m -O $KERNEL_OUT $KERNEL_OUT/.config \
#     device/hotdog/kernel-fingerprint.config
# Both modules bind nothing until the plan's overlays enable their nodes.
CONFIG_GOODIX_FP=m
CONFIG_QCOM_QSEECOM_COMPAT=m
